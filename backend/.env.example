NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
RESEND_API_KEY=
# Set this to an address on a domain verified with Resend.
EMAIL_FROM=

# Twilio: Account SID, Auth Token, and an approved Twilio sender.
# For India, configure DLT-registered sender/header and message templates with the provider before production use.
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
TMDB_ACCESS_TOKEN=

